# Supabase project used for BOTH researcher auth/profiles AND the Control
# schema (study_backends/studies) — this is the same project the companion
# iOS app talks to (inoxity_backend). Find these under Settings → API — use
# the Project URL and the anon/public key, never the service_role key (this
# app never needs service_role; ownership is enforced by Postgres RLS, not
# application code — see inoxity_v2/supabase/control_backend/migrations/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (resend.com) — used to send team-invite emails and to relay the
# iOS app's "contact the research team" messages (src/app/api/contact).
# Server-only — never prefix these with NEXT_PUBLIC_, or the key ships to
# the browser bundle. Get RESEND_API_KEY from Resend's dashboard after
# verifying a sending domain; EMAIL_FROM must be an address on that domain.
RESEND_API_KEY=
EMAIL_FROM="Inoxity <noreply@yourdomain.com>"

# The Resend segment that the public /updates mailing-list form adds
# contacts to (Resend dashboard → Audience → Segments). Contact creation
# requires RESEND_API_KEY to be a Full access key, not Sending access.
RESEND_SEGMENT_ID=

# A shared secret the iOS app sends as a header on /api/contact requests
# (that route is unauthenticated — no researcher session — since it's
# called by the participant app, not a signed-in dashboard user). Not real
# security, just a deterrent against random internet traffic hitting the
# endpoint and sending mail through your Resend account. Generate any long
# random string and put the same value in the iOS app's build config.
CONTACT_SHARED_SECRET=
